{
  "openapi": "3.1.0",
  "info": {
    "title": "rdstudio serve",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "LearnerState": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Send as X-Rdstudio-Token when writing."
          },
          "dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearnerEvent"
            }
          }
        },
        "required": [
          "enabled",
          "token",
          "dir",
          "events"
        ]
      },
      "LearnerEvent": {
        "type": "object",
        "additionalProperties": {},
        "description": "One event: `event` (a name), optionally `concept`, `hash`, `kind` (autodidactic, interactive or ai), `id` and `device`; the server stamps `at`."
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PrivateTour": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lowercase letters, digits and dashes."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "Markdown: a list whose items each start with a link to a stop, then its narration."
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "body"
        ]
      },
      "PrivateTourSave": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ]
      },
      "EditState": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Send as X-Rdstudio-Token when saving."
          },
          "actor": {
            "type": "string",
            "description": "Who edits are attributed to, such as human:lachlan."
          }
        },
        "required": [
          "enabled",
          "token",
          "actor"
        ]
      },
      "NoteHistory": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean",
            "description": "Whether the project is a git repository."
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hash": {
                  "type": "string"
                },
                "short": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                }
              },
              "required": [
                "hash",
                "short",
                "author",
                "date",
                "subject"
              ]
            }
          },
          "diff": {
            "type": [
              "string",
              "null"
            ],
            "description": "The note then against now, as a unified diff, uncommitted changes included."
          },
          "base": {
            "type": [
              "string",
              "null"
            ]
          },
          "existed": {
            "type": "boolean"
          }
        },
        "required": [
          "available",
          "commits",
          "diff",
          "base",
          "existed"
        ]
      },
      "NoteSource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Relative to the knowledge folder."
          },
          "version": {
            "type": "string",
            "description": "Of the whole file; send it back as `base` when saving."
          },
          "meta": {
            "$ref": "#/components/schemas/NoteMeta"
          },
          "frontmatter": {
            "type": "string",
            "description": "The YAML between the --- lines."
          },
          "body": {
            "type": "string",
            "description": "Everything after the frontmatter, verbatim."
          }
        },
        "required": [
          "id",
          "path",
          "version",
          "meta",
          "frontmatter",
          "body"
        ]
      },
      "NoteMeta": {
        "type": "object",
        "additionalProperties": {},
        "description": "Frontmatter fields."
      },
      "Moved": {
        "type": "object",
        "properties": {
          "moved": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          },
          "rewritten": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files whose links were updated."
          }
        },
        "required": [
          "moved",
          "rewritten"
        ]
      },
      "NoteConflict": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "current": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NoteSource"
              },
              {
                "type": [
                  "object",
                  "null"
                ]
              }
            ]
          }
        },
        "required": [
          "error",
          "current"
        ]
      },
      "NoteMove": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "The new id, such as philosophy/motivation."
          },
          "base": {
            "type": [
              "string",
              "null"
            ],
            "description": "The note's version; refused if it changed since."
          }
        },
        "required": [
          "to"
        ]
      },
      "NoteDeleted": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "string"
          },
          "backlinks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Notes that linked to it; those links are now broken."
          }
        },
        "required": [
          "deleted",
          "backlinks"
        ]
      },
      "FolderMove": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "FolderDeleted": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The notes deleted with it."
          },
          "backlinks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Notes elsewhere that linked into it; those links are now broken."
          }
        },
        "required": [
          "deleted",
          "notes",
          "backlinks"
        ]
      },
      "NoteSaved": {
        "type": "object",
        "properties": {
          "note": {
            "$ref": "#/components/schemas/NoteSource"
          },
          "created": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          },
          "significant": {
            "type": "boolean"
          }
        },
        "required": [
          "note",
          "created",
          "changed",
          "significant"
        ]
      },
      "NoteSave": {
        "type": "object",
        "properties": {
          "base": {
            "type": [
              "string",
              "null"
            ],
            "description": "The version the edit started from; null creates the note."
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {},
            "description": "Fields to set; null removes one."
          }
        },
        "required": [
          "base"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/learner": {
      "get": {
        "summary": "The learner record: whether it is on, a write token, and every event",
        "responses": {
          "200": {
            "description": "The record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerState"
                }
              }
            }
          },
          "403": {
            "description": "Host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Append one event to the learner record",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-rdstudio-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LearnerEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The event as stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerEvent"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin request, bad token or host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The learner record is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Event too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/learner/tours": {
      "get": {
        "summary": "Your private tours (none while the learner record is off)",
        "responses": {
          "200": {
            "description": "The tours",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PrivateTour"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/learner/tours/{name}": {
      "put": {
        "summary": "Write one of your private tours",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "name",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-rdstudio-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrivateTourSave"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tour as saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateTour"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid tour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin request, bad token or host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The learner record is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete one of your private tours",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "name",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-rdstudio-token",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Not a valid tour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin request, bad token or host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The learner record is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/edit": {
      "get": {
        "summary": "Whether notes can be edited here, and the token to do it with",
        "responses": {
          "200": {
            "description": "The editing state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditState"
                }
              }
            }
          },
          "403": {
            "description": "Host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/history/{id}": {
      "get": {
        "summary": "What changed in a note since a time: commits and a diff (catching up)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The note's id, such as design/model (slashes encoded)."
            },
            "required": true,
            "description": "The note's id, such as design/model (slashes encoded).",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "An ISO time, such as when you last looked."
            },
            "required": true,
            "description": "An ISO time, such as when you last looked.",
            "name": "since",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteHistory"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid note or time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{id}": {
      "get": {
        "summary": "A note's source, to edit",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The note's id, such as design/model (slashes encoded)."
            },
            "required": true,
            "description": "The note's id, such as design/model (slashes encoded).",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteSource"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid note id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a note",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The note's id, such as design/model (slashes encoded)."
            },
            "required": true,
            "description": "The note's id, such as design/model (slashes encoded).",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "base",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-rdstudio-token",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteDeleted"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin request, bad token, host not allowed, or read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The note changed since `base`, or is gone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteConflict"
                }
              }
            }
          },
          "415": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save an edit to a note, or create it",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The note's id, such as design/model (slashes encoded)."
            },
            "required": true,
            "description": "The note's id, such as design/model (slashes encoded).",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-rdstudio-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteSave"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteSaved"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid edit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin request, bad token, host not allowed, or read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The note changed since `base` (or exists, when creating): the current note is included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteConflict"
                }
              }
            }
          },
          "413": {
            "description": "Too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{id}/move": {
      "post": {
        "summary": "Move or rename a note, updating the links to it",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The note's id, such as design/model (slashes encoded)."
            },
            "required": true,
            "description": "The note's id, such as design/model (slashes encoded).",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-rdstudio-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteMove"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Moved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Moved"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
