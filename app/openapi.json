{
  "openapi": "3.1.0",
  "info": {
    "title": "rdstudio serve",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "LearnerState": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Send as X-Rdstudio-Token when writing."
          },
          "dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearnerEvent"
            }
          }
        },
        "required": [
          "enabled",
          "token",
          "dir",
          "events"
        ]
      },
      "LearnerEvent": {
        "type": "object",
        "additionalProperties": {},
        "description": "One event: `event` (a name), optionally `concept`, `hash`, `kind` (autodidactic, interactive or ai), `id` and `device`; the server stamps `at`."
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/learner": {
      "get": {
        "summary": "The learner record: whether it is on, a write token, and every event",
        "responses": {
          "200": {
            "description": "The record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerState"
                }
              }
            }
          },
          "403": {
            "description": "Host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Append one event to the learner record",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "x-rdstudio-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LearnerEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The event as stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerEvent"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin request, bad token or host not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The learner record is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Event too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
