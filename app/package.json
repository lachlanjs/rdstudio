{
  "name": "@rdstudio/app",
  "version": "0.1.0",
  "private": true,
  "description": "The rdstudio dashboard: a SvelteKit single-page app over the files rdstudio build writes.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/relative.ts",
    "preview": "vite preview",
    "generate": "node scripts/openapi.ts && openapi-ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@rdstudio/core": "*",
    "d3": "^7.9.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^14.3.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
